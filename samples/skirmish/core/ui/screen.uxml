<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- Unity 호스트의 화면 (spec-gaps G330~G355). house에는 호스트가 그 연결이 앉은 진영을 넣는다 -->
  <ui:Style src="ui/screen.uss" />
  <ui:VisualElement name="screen" params="house" seat="house" picking-mode="Ignore">
    <ui:Label name="turn" bind-text="skirmish.turn_number(house)" />
    <ui:Button name="ask-end" text="end turn" on-click="skirmish.ask_end_turn()" />
    <ui:VisualElement name="units" class="units" picking-mode="Ignore" for="row in skirmish.units(house)">
      <ui:Include src="ui/unit-card.uxml" unit="row.unit" house="house" />
    </ui:VisualElement>

    <!-- 보통 창: 제목줄로 끌고, ESC나 close로 닫는다 -->
    <ui:VisualElement name="unit-info" class="window" window="normal" bind-display="skirmish.inspected()" on-close="skirmish.close_inspect()">
      <ui:Label name="info-title" class="title" text="unit" window-drag="true" />
      <!-- 연 유닛이 있을 때만 요약을 만든다: 숨긴 창 안에서도 바인딩은 계산되므로 (G449) -->
      <ui:VisualElement name="info-body" if="skirmish.inspected()">
        <ui:Include src="ui/unit-summary.uxml" unit="skirmish.inspected()" />
      </ui:VisualElement>
      <ui:Button name="info-close" text="close" on-click="skirmish.close_inspect()" />
    </ui:VisualElement>

    <!-- 모달: 대답할 때까지 뒤를 누를 수 없다. endturn은 차례인 쪽만 누를 수 있다 -->
    <ui:VisualElement name="confirm" class="window" window="modal" bind-display="skirmish.asking_end_turn()" on-close="skirmish.cancel_end_turn()">
      <ui:Label text="end the turn?" />
      <ui:Button name="endturn" text="end turn" on-click="skirmish.EndTurn(house)" />
      <ui:Button name="cancel" text="cancel" on-click="skirmish.cancel_end_turn()" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
