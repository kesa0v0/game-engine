/* skirmish 화면의 모양 (G359). 글자색 같은 기본 테마는 게임이 화면 맨 바깥에 붙인다 */
:root {
    --edge: rgb(80, 84, 96);
    --mine: rgb(90, 140, 220);
    --chosen: rgb(250, 205, 70);
}

#screen {
    padding: 16px;
    flex-grow: 1;
}

#turn {
    font-size: 28px;
    -unity-font-style: bold;
}

#ask-end {
    align-self: flex-start;
    width: 140px;
    height: 32px;
    margin-top: 8px;
}

.units {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
}

.card {
    width: 160px;
    margin: 6px;
    padding: 10px;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--edge);
    background-color: rgb(40, 43, 52);
}

.card.mine {
    border-color: var(--mine);
}

.card:hover {
    background-color: rgb(52, 56, 68);
}

.card.selected {
    border-color: var(--chosen);
    background-color: rgb(70, 64, 36);
}

.card.acted {
    opacity: 0.45;
}

.card #kind {
    font-size: 18px;
    -unity-font-style: bold;
}

.card #hp {
    margin-bottom: 6px;
}

.window {
    min-width: 220px;
    padding: 12px;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(150, 155, 175);
    background-color: rgb(30, 33, 42);
}

#unit-info {
    left: 1100px;
    top: 120px;
}

#confirm {
    left: 760px;
    top: 380px;
}

.window .title {
    margin: -12px -12px 10px -12px;
    padding: 8px 12px;
    background-color: rgb(60, 65, 85);
    -unity-font-style: bold;
}

.modal-blocker {
    background-color: rgba(0, 0, 0, 0.55);
}
