<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity가 소스 패키지로 컴파일할 수 있게 C# 9로 고정 (spec P1a) -->
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Kesa.Engine</RootNamespace>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <!-- 결정론을 C# 쪽에도 구조로 강제 (spec P2). 호스트 함수 프로젝트도 같은 파일을 가져다 쓴다 (spec-gaps G220) -->
  <Import Project="..\Kesa.Engine.Analyzers\Determinism.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="Kesa.Engine.Kernel.Tests" />
  </ItemGroup>

</Project>
