<Project Sdk="Microsoft.NET.Sdk">

  <!-- 규모 벤치 (spec 9절, spec-gaps G223). dotnet test에 들지 않는다. 실행: dotnet run -c Release, 프로젝트는 bench/Kesa.Engine.Bench -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Kesa.Engine.Bench</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- 처음부터 최적화된 코드로: 단계별 JIT가 장면마다 다른 단계에서 재지 않게 -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kesa.Engine.Kernel\Kesa.Engine.Kernel.csproj" />
  </ItemGroup>

</Project>
